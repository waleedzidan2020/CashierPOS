<Window x:Class="CashierPOS.WPF.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CashierPOS" Width="1280" Height="720" MinWidth="1000" MinHeight="620" WindowStartupLocation="CenterScreen" FlowDirection="{Binding Direction}" Closing="WindowClosing" Loaded="WindowLoaded" PreviewKeyDown="Shortcut" PreviewMouseDown="TouchActivity" PreviewMouseMove="TouchActivity">
 <Grid x:Name="Root"><Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.RowSpan="3" Background="#16243D"><DockPanel Margin="14"><StackPanel DockPanel.Dock="Top" Margin="8,16,0,28"><TextBlock Text="CashierPOS" Foreground="White" FontSize="25" FontWeight="Bold"/><TextBlock Text="OFFLINE RETAIL WORKSPACE" Foreground="#8DADD7" FontSize="10" Margin="0,6,0,0"/></StackPanel><ListBox ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedNav}" DisplayMemberPath="Title" Background="Transparent" BorderThickness="0" Foreground="#DBE7FD" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="NavBorder" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#2463EB"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox></DockPanel></Border>
  <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><DockPanel Margin="20,10"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="{Binding L[Change password]}" Command="{Binding ChangePasswordCommand}" FontSize="11"/><Button Content="{Binding L[Lock]}" Command="{Binding LockCommand}" FontSize="11"/><Button Content="{Binding L[Logout]}" Command="{Binding LogoutCommand}" FontSize="11"/></StackPanel><StackPanel><TextBlock Text="{Binding StoreName}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding UserLabel}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DockPanel></Border>
  <Grid Grid.Row="1" Grid.Column="1" Margin="20,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,10"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding ShowDates,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding L[From]}" VerticalAlignment="Center" Margin="6"/><DatePicker SelectedDate="{Binding FromDate}" Width="125"/><TextBlock Text="{Binding L[Through]}" VerticalAlignment="Center" Margin="6"/><DatePicker SelectedDate="{Binding ThroughDate}" Width="125"/></StackPanel><TextBlock Text="{Binding SelectedNav.Title}" FontSize="26" FontWeight="SemiBold"/></DockPanel>
   <ItemsControl Grid.Row="1" ItemsSource="{Binding Actions}" IsEnabled="{Binding Ready}" Margin="-4,0,0,12"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Title}" Command="{Binding DataContext.ActionCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Key}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Grid Grid.Row="2" Visibility="{Binding IsPos,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding Ready}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding L[Search products]}" FontWeight="SemiBold" FontSize="16"/><DockPanel Grid.Row="1"><Button DockPanel.Dock="Right" Content="F2 / Search" Command="{Binding FindCommand}"/><TextBox x:Name="BarcodeInput" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" KeyDown="BarcodeKey"/></DockPanel><DataGrid Grid.Row="2" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedProduct}" AutoGenerateColumns="False" MouseDoubleClick="ProductDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="95"/><DataGridTextColumn Header="Product / المنتج" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Price / السعر" Binding="{Binding Price,StringFormat=N2}" Width="75"/><DataGridTextColumn Header="Stock / مخزون" Binding="{Binding Stock}" Width="65"/></DataGrid.Columns></DataGrid><Button Grid.Row="3" Content="Add selected / إضافة المحدد" Command="{Binding AddProductCommand}" Margin="0,12,0,0"/></Grid></Border>
    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="{Binding L[Cart]}" FontSize="18" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="{Binding L[Remove]}" Command="{Binding RemoveItemCommand}"/></DockPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Cart}" SelectedItem="{Binding SelectedCart}" AutoGenerateColumns="False" IsReadOnly="False"><DataGrid.Columns><DataGridTextColumn Header="Product / المنتج" Binding="{Binding Name}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Qty / كمية" Binding="{Binding Quantity,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" Width="65"/><DataGridTextColumn Header="Price / السعر" Binding="{Binding Price,StringFormat=N2}" IsReadOnly="True" Width="75"/><DataGridTextColumn Header="Total / إجمالي" Binding="{Binding Total,StringFormat=N2}" IsReadOnly="True" Width="85"/></DataGrid.Columns></DataGrid>
     <StackPanel Grid.Row="2" Margin="0,10,0,0"><DockPanel><TextBlock Text="{Binding L[Subtotal]}"/><TextBlock DockPanel.Dock="Right" Text="{Binding Subtotal,StringFormat=N2}" FontWeight="SemiBold" HorizontalAlignment="Right"/></DockPanel><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding L[Discount]}"/><TextBox Text="{Binding Discount,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding L[Tax]}"/><TextBlock Text="{Binding Tax,StringFormat=N2}" Margin="4,8"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding L[Total]}"/><TextBlock Text="{Binding GrandTotal,StringFormat=N2}" FontSize="25" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/></StackPanel></Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding L[Cash tendered]}"/><TextBox x:Name="CashInput" Text="{Binding Cash,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding L[Card amount]}"/><TextBox Text="{Binding Card,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid><DockPanel><TextBlock Text="Change / الباقي"/><TextBlock Text="{Binding Change,StringFormat=N2}" FontWeight="Bold" HorizontalAlignment="Right"/></DockPanel>
      <DockPanel Margin="0,4"><TextBlock Text="{Binding L[Customer ID (optional)]}" VerticalAlignment="Center"/><TextBox Text="{Binding CustomerId}" Width="100" Margin="6,0"/></DockPanel><WrapPanel><Button Content="F4 %" Command="{Binding DiscountDialogCommand}"/><Button Content="Price / السعر" Command="{Binding OverridePriceCommand}"/><Button Content="{Binding L[Suspend]}" Command="{Binding SuspendCommand}"/><Button Content="{Binding L[Resume]}" Command="{Binding ResumeCommand}"/><Button Content="{Binding L[Clear cart]}" Command="{Binding ClearCartCommand}"/></WrapPanel><Button Content="{Binding L[Complete sale]}" Command="{Binding CompleteCommand}" FontSize="18" Padding="15,12"/></StackPanel>
    </Grid></Border>
   </Grid>
   <ScrollViewer Grid.Row="2" Visibility="{Binding IsDashboard,Converter={StaticResource BoolVisibility}}" VerticalScrollBarVisibility="Auto"><StackPanel><ItemsControl ItemsSource="{Binding Stats}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="230" Background="{DynamicResource SurfaceBrush}" Padding="20" CornerRadius="12" Margin="0,0,14,14"><StackPanel><TextBlock Text="{Binding Title}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Value}" FontSize="23" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="22"><StackPanel><TextBlock Text="7 days · Net revenue excluding tax / الإيراد بدون ضريبة" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16"/><ItemsControl ItemsSource="{Binding Bars}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" VerticalAlignment="Center"/><Border Grid.Column="1" Height="24" Width="{Binding Width}" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" CornerRadius="5"/><TextBlock Grid.Column="2" Text="{Binding Amount}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel></ScrollViewer>
   <DataGrid Grid.Row="2" Visibility="{Binding IsTable,Converter={StaticResource BoolVisibility}}" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="True" AutoGeneratingColumn="GenerateColumn" IsEnabled="{Binding Ready}"/>
  </Grid>
  <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource SurfaceBrush}"><DockPanel Margin="20,5"><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"/><ProgressBar DockPanel.Dock="Right" Width="90" IsIndeterminate="True" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}"/></DockPanel></Border>
 </Grid>
</Window>

<Window x:Class="CashierPOS.WPF.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CashierPOS" Width="490" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
 <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="34" Margin="20"><StackPanel>
  <TextBlock Text="CashierPOS" FontSize="30" FontWeight="Bold"/><TextBlock Text="{Binding Title}" Margin="0,10,0,24" TextWrapping="Wrap"/>
  <TextBlock Text="Username / اسم المستخدم"/><TextBox Text="{Binding Username,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UsernameEditable}"/>
  <StackPanel Visibility="{Binding IsSetup,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Full name / الاسم الكامل"/><TextBox Text="{Binding FullName}"/></StackPanel>
  <TextBlock Text="Password / كلمة المرور"/><PasswordBox x:Name="Secret" PasswordChanged="PasswordChanged"/>
  <TextBox x:Name="VisiblePassword" Visibility="Collapsed" Text="{Binding Password,UpdateSourceTrigger=PropertyChanged}"/>
  <CheckBox Content="Show password / إظهار كلمة المرور" Checked="ShowPassword" Unchecked="HidePassword" Margin="0,0,0,12"/>
  <CheckBox Content="Remember username / تذكّر اسم المستخدم" IsChecked="{Binding Remember}"/>
  <TextBlock Text="{Binding Message}" Foreground="#E34D59" TextWrapping="Wrap" Margin="0,14,0,8"/>
  <Button Content="Continue / دخول" Command="{Binding SignInCommand}" IsDefault="True"/>
  <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}"/>
  <TextBlock Text="Offline • Your store, on your computer" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
 </StackPanel></Border>
</Window>
